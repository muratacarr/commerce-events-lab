    {
      "name": "pip-audit",
      "category": "dependencies",
      "command": ["python", "tools/venv_run.py", "-m", "pip_audit", "-r", "requirements-dev.lock", "--no-deps", "--disable-pip", "--progress-spinner", "off"]
    }
