    {
      "name": "ruff-lint",
      "category": "static",
      "command": ["python", "tools/venv_run.py", "-m", "ruff", "check", "src", "tests", "tools"]
    },
    {
      "name": "ruff-format",
      "category": "static",
      "command": ["python", "tools/venv_run.py", "-m", "ruff", "format", "--check", "src", "tests", "tools"]
    },
    {
      "name": "mypy-src",
      "category": "static",
      "command": ["python", "tools/venv_run.py", "-m", "mypy", "src"]
    },
    {
      "name": "detect-secrets",
      "category": "secrets",
      "command": ["python", "tools/venv_run.py", "tools/scan_secrets.py"]
